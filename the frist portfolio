
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080b16">
  <meta name="description" content="Romani Gorg | Software Engineer portfolio">
  <title>Romani Gorg | Software Engineer</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #080b16;
      --card: #11172a;
      --blue: #648cff;
      --purple: #a16bff;
      --text: #f5f6ff;
      --muted: #a1abc6;
      --border: #252d47;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 85px;
    }

    body {
      font-family: "DM Sans", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    .container {
      width: min(1100px, 90%);
      margin: auto;
    }

    .gradient {
      background: linear-gradient(100deg, #73a6ff, #b17bff);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    /* Navigation */

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(8, 11, 22, .9);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid #ffffff0c;
    }

    nav {
      min-height: 75px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-family: "Space Grotesk", sans-serif;
      font-size: 19px;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .logo span {
      color: var(--purple);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 27px;
    }

    .nav-links a {
      color: var(--muted);
      font-size: 13px;
      transition: .25s;
    }

    .nav-links a:hover {
      color: white;
    }

    .nav-links .nav-button {
      padding: 9px 16px;
      border: 1px solid #6459a6;
      border-radius: 9px;
      color: white;
    }

    .menu-toggle {
      display: none;
      color: white;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 7px 11px;
      font-size: 22px;
      cursor: pointer;
    }

    /* Hero */

    .hero {
      min-height: 660px;
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      align-items: center;
      gap: 45px;
      padding-top: 70px;
      padding-bottom: 80px;
    }

    .eyebrow {
      display: inline-block;
      color: #a7b5db;
      background: #151b30;
      border: 1px solid var(--border);
      border-radius: 30px;
      padding: 7px 13px;
      font-size: 10px;
      letter-spacing: 1.4px;
    }

    h1, h2, h3 {
      font-family: "Space Grotesk", sans-serif;
      line-height: 1.2;
    }

    h1 {
      font-size: clamp(40px, 5vw, 64px);
      letter-spacing: -2px;
      margin: 24px 0;
    }

    .hero p {
      max-width: 500px;
      color: var(--muted);
      font-size: 15px;
      margin-bottom: 27px;
    }

    .buttons {
      display: flex;
      gap: 13px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 9px;
      padding: 12px 19px;
      border-radius: 9px;
      font-size: 13px;
      font-weight: 700;
      transition: .25s;
      cursor: pointer;
    }

    .btn:hover {
      transform: translateY(-3px);
    }

    .primary {
      background: linear-gradient(110deg, var(--blue), var(--purple));
      color: white;
      box-shadow: 0 8px 25px #765bff30;
    }

    .secondary {
      background: var(--card);
      border: 1px solid #343e60;
    }

    .socials {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-top: 32px;
    }

    .socials span {
      color: #7783a2;
      font-size: 10px;
      letter-spacing: 1px;
    }

    .socials a {
      color: #b8c3e0;
      font-weight: 700;
      font-size: 12px;
      transition: .2s;
    }

    .socials a:hover {
      color: var(--purple);
    }

    /* Decorative code card */

    .code-card {
      position: relative;
      padding: 25px 20px;
      background: linear-gradient(145deg, #151e37, #0d1222);
      border: 1px solid #4e5d8a66;
      border-radius: 18px;
      box-shadow: 0 25px 80px #0006, 0 0 70px #7755ff14;
      animation: float 5s ease-in-out infinite;
    }

    .code-top {
      display: flex;
      align-items: center;
      gap: 6px;
      padding-bottom: 20px;
      margin-bottom: 17px;
      border-bottom: 1px solid #ffffff10;
      color: #8d9abb;
      font-size: 11px;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #ff7588;
    }

    .dot:nth-child(2) { background: #ffcf70; }
    .dot:nth-child(3) { background: #63e5ae; }

    .filename {
      margin-left: 9px;
    }

    .code-lines {
      font: 12px/2.4 monospace;
      color: #dce4ff;
      overflow-wrap: anywhere;
    }

    .line-no {
      display: inline-block;
      width: 25px;
      color: #596785;
    }

    .purple { color: #c4a0ff; }
    .green { color: #9de6bd; }
    .blue { color: #80caff; }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-9px); }
    }

    /* General sections */

    section.content-section {
      padding: 90px 0;
    }

    .section-title {
      margin-bottom: 35px;
    }

    .section-label {
      display: block;
      color: #a997ff;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      margin-bottom: 13px;
    }

    .section-title h2 {
      font-size: clamp(29px, 4vw, 42px);
      margin-bottom: 14px;
    }

    .section-title p {
      color: var(--muted);
      font-size: 14px;
      max-width: 600px;
    }

    /* About */

    .about-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .card {
      background: linear-gradient(145deg, #141b30, #0d1221);
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 25px;
      transition: .3s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: #8276d966;
    }

    .card-icon {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: #7663ff20;
      color: #b6a5ff;
      font-size: 22px;
      margin-bottom: 20px;
    }

    .card h3 {
      font-size: 17px;
      margin-bottom: 12px;
    }

    .card p {
      color: var(--muted);
      font-size: 13px;
    }

    /* Skills */

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 14px;
    }

    .skill {
      text-align: center;
      padding: 23px 12px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      transition: .25s;
    }

    .skill:hover {
      transform: translateY(-6px);
      border-color: var(--purple);
    }

    .skill-icon {
      width: 52px;
      height: 52px;
      display: grid;
      place-items: center;
      margin: 0 auto 15px;
      border-radius: 14px;
      font: 700 18px "Space Grotesk", sans-serif;
      background: #202746;
      color: #9bb9ff;
    }

    .skill:nth-child(2) .skill-icon { color: #80baff; }
    .skill:nth-child(3) .skill-icon { color: #ffe17d; }
    .skill:nth-child(4) .skill-icon { color: #71ddff; }
    .skill:nth-child(5) .skill-icon { color: #71ddff; }

    .skill h3 {
      font-size: 14px;
      margin-bottom: 8px;
    }

    .skill p {
      color: var(--muted);
      font-size: 11px;
    }

    /* Projects */

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .project-preview {
      height: 160px;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 70% 30%, #8b5cf633, transparent 45%),
        linear-gradient(135deg, #17264a, #151128);
      border-radius: 10px;
      margin-bottom: 20px;
      overflow: hidden;
    }

    .preview-window {
      width: 76%;
      padding: 13px;
      background: #0b1120;
      border: 1px solid #596da766;
      border-radius: 8px;
      transform: rotate(-3deg);
      box-shadow: 0 12px 30px #0005;
    }

    .preview-bar {
      height: 6px;
      width: 50%;
      border-radius: 5px;
      background: linear-gradient(90deg, var(--blue), var(--purple));
      margin-bottom: 12px;
    }

    .preview-row {
      display: flex;
      gap: 7px;
      margin-top: 8px;
    }

    .preview-row i {
      height: 32px;
      flex: 1;
      border-radius: 4px;
      background: #222d4d;
    }

    .project-type {
      color: #a997ff;
      font-size: 10px;
      letter-spacing: 1.3px;
      margin-bottom: 8px;
    }

    .project-card h3 {
      font-size: 18px;
      margin-bottom: 10px;
    }

    .project-card > p {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 17px;
    }

    .tags {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
    }

    .tags span {
      font-size: 10px;
      color: #c5d0ee;
      background: #202943;
      border: 1px solid #303c5c;
      padding: 5px 9px;
      border-radius: 6px;
    }

    .notice {
      margin-top: 20px;
      font-size: 11px;
      color: #7e8aaa;
    }

    /* Contact */

    #contact {
      text-align: center;
      background: radial-gradient(ellipse at bottom, #5b3eb326, transparent 65%);
      border-top: 1px solid #ffffff0d;
    }

    .contact-inner {
      max-width: 680px;
      margin: auto;
    }

    .contact-inner h2 {
      font-size: clamp(32px, 5vw, 48px);
      margin-bottom: 18px;
    }

    .contact-inner p {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 27px;
    }

    .contact-inner .btn {
      border: 0;
    }

    .contact-socials {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 25px;
      margin-top: 35px;
    }

    .contact-socials a {
      color: #aeb8d2;
      font-size: 12px;
    }

    .contact-socials a:hover {
      color: var(--purple);
    }

    footer {
      padding: 25px 0;
      border-top: 1px solid #ffffff0c;
      color: #7985a2;
      font-size: 11px;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
    }

    /* Reveal animations */

    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity .7s ease, transform .7s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation: none !important;
        scroll-behavior: auto !important;
        transition: none !important;
      }

      .reveal {
        opacity: 1;
        transform: none;
      }
    }

    /* Tablet */

    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 45px;
        padding-top: 65px;
      }

      .hero-copy {
        max-width: 650px;
      }

      .code-card {
        max-width: 600px;
        width: 100%;
        margin: auto;
      }

      .about-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .skills-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .projects-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    /* Mobile */

    @media (max-width: 600px) {
      .container {
        width: 90%;
      }

      nav {
        min-height: 68px;
      }

      .menu-toggle {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 68px;
        left: 0;
        right: 0;
        padding: 18px 5%;
        background: #0c1120;
        border-bottom: 1px solid var(--border);
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        padding: 12px 5px;
      }

      .nav-links .nav-button {
        text-align: center;
        margin-top: 10px;
      }

      .hero {
        min-height: auto;
        padding-top: 55px;
        padding-bottom: 65px;
      }

      h1 {
        font-size: clamp(39px, 11vw, 52px);
      }

      .hero p {
        font-size: 13px;
      }

      .code-card {
        padding: 20px 12px;
      }

      .code-lines {
        font-size: 10px;
      }

      section.content-section {
        padding: 70px 0;
      }

      .about-grid,
      .projects-grid {
        grid-template-columns: 1fr;
      }

      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .card {
        padding: 22px;
      }

      .footer-inner {
        flex-direction: column;
        text-align: center;
      }

      .socials {
        gap: 12px;
      }
    }
  </style>
</head>

